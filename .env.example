# Conexión a Postgres. En Dokploy el host es el appName del servicio de base de
# datos, que se resuelve dentro de la red interna de Docker.
DATABASE_URL=postgresql://postgres:LA_CONTRASENA@planner-planner-n4tffw:5432/postgres

# Puerto en el que escucha el servidor dentro del contenedor.
PORT=3000

# Poner a 1 sólo la primera vez: siembra los proyectos de ejemplo, y sólo si la
# base está completamente vacía. Nunca pisa datos existentes.
SEMBRAR=0
